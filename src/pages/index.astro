---
import Layout from "../layouts/Layout.astro";
import AwardBadge from "../components/AwardBadge.astro";
import { getDownloadsData } from "../lib/downloads";
import deviceNames from "../data/devices.json";

const data = await getDownloadsData();
const { devices, grandTotal, totalBuilds, isCached, savedAt, fetchError } = data;

const maxTotal = devices[0]?.total ?? 1;

const deviceMap = deviceNames as Record<string, string>;
function getDeviceName(codename: string): string {
  return deviceMap[codename] || deviceMap[codename.toLowerCase()] || codename;
}

function relativeTime(iso: string) {
  const diffMs = Date.now() - new Date(iso).getTime();
  const hours = Math.round(diffMs / 3_600_000);
  if (hours < 1) return "under an hour ago";
  if (hours < 24) return `${hours}h ago`;
  const days = Math.round(hours / 24);
  return `${days}d ago`;
}
---

<Layout title="Halcyon Stats">
  <!-- Hero Section -->
  <section class="pb-12 pt-8 md:pb-16 md:pt-14">
    <h1
      class="font-[var(--font-display)] text-5xl sm:text-7xl md:text-8xl font-black leading-[0.95] tracking-tight"
      style="font-variation-settings: 'wght' 900, 'wdth' 100;"
    >
      <i>h.</i><br />Stats
    </h1>
    
    <!-- Stat Highlights -->
    <div class="mt-10 grid gap-4 grid-cols-1 sm:grid-cols-3">
      <div
        class="card-lift theme-transition rounded-[var(--radius-xl)] bg-[var(--color-primary-container)] p-6 text-[var(--color-on-primary-container)]"
      >
        <div class="flex items-center justify-between text-xs font-semibold uppercase tracking-wider opacity-80">
          <span>Downloads</span>
          <span class="rounded-full bg-black/10 dark:bg-white/20 px-2 py-0.5 text-[10px]">All time</span>
        </div>
        <p class="count-up mt-3 font-mono text-3xl sm:text-4xl font-black" data-target={grandTotal}>{grandTotal.toLocaleString()}</p>
        <p class="mt-1 text-xs opacity-75 font-mono">packages</p>
      </div>

      <div
        class="card-lift theme-transition rounded-[var(--radius-xl)] bg-[var(--color-tertiary-container)] p-6 text-[var(--color-ink)]"
      >
        <div class="flex items-center justify-between text-xs font-semibold uppercase tracking-wider opacity-80">
          <span>Devices</span>
          <span class="rounded-full bg-black/10 dark:bg-white/20 px-2 py-0.5 text-[10px]">Tracked</span>
        </div>
        <p class="count-up mt-3 font-mono text-3xl sm:text-4xl font-black" data-target={devices.length}>{devices.length}</p>
        <p class="mt-1 text-xs opacity-75 font-mono">unique codenames</p>
      </div>

      <div
        class="card-lift theme-transition rounded-[var(--radius-xl)] bg-[var(--color-quaternary-container)] p-6 text-[var(--color-ink)]"
      >
        <div class="flex items-center justify-between text-xs font-semibold uppercase tracking-wider opacity-80">
          <span>Builds</span>
          <span class="rounded-full bg-black/10 dark:bg-white/20 px-2 py-0.5 text-[10px]">OTA / Fastboot</span>
        </div>
        <p class="count-up mt-3 font-mono text-3xl sm:text-4xl font-black" data-target={totalBuilds}>{totalBuilds.toLocaleString()}</p>
        <p class="mt-1 text-xs opacity-75 font-mono">packages delivered</p>
      </div>
    </div>
  </section>

  <!-- Offline Cache Banner or Error / Empty State -->
  {
    isCached && (
      <div class="my-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2 rounded-[var(--radius-lg)] border border-[var(--color-surface-dim)] bg-[var(--color-surface-container)] px-5 py-3 text-xs text-[var(--color-secondary)]">
        <span>Data loaded from backup cache (API timeout / unavailable)</span>
        <span class="font-mono">Sync date: {savedAt ? savedAt.slice(0, 10) : "recent"}</span>
      </div>
    )
  }

  {
    fetchError && devices.length === 0 && (
      <div class="my-8 rounded-[var(--radius-xl)] border border-[var(--color-surface-dim)] bg-[var(--color-surface-container)] p-6 sm:p-8 text-center">
        <p class="font-medium text-[var(--color-primary)]">Unable to fetch download data</p>
        <p class="mt-2 text-sm text-[var(--color-secondary)]">
          {fetchError}. Please try rebuilding the page in a moment.
        </p>
      </div>
    )
  }

  {
    !fetchError && devices.length === 0 && (
      <div class="my-8 rounded-[var(--radius-xl)] border border-[var(--color-surface-dim)] bg-[var(--color-surface-container)] p-6 sm:p-8 text-center text-[var(--color-secondary)]">
        No installer downloads recorded yet.
      </div>
    )
  }

  <!-- Leaderboard Section -->
  {
    devices.length > 0 && (
      <section class="pb-20">
        <div class="mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-[var(--color-surface-dim)] pb-5">
          <div>
            <h2 class="font-[var(--font-display)] text-2xl sm:text-3xl font-bold text-[var(--color-ink)]">
              Device Rankings
            </h2>
            <p class="mt-1 text-xs sm:text-sm text-[var(--color-secondary)]">
              Ranked total downloads counts
            </p>
          </div>

          <div class="flex items-center gap-3">
            <div class="relative w-full sm:w-64">
              <input
                id="device-search"
                type="search"
                placeholder="Search device or codename..."
                class="w-full rounded-full border border-[var(--color-surface-dim)] bg-[var(--color-surface-container)] px-4 py-2 text-xs sm:text-sm text-[var(--color-ink)] placeholder-[var(--color-secondary)] transition-colors focus:border-[var(--color-primary)] focus:outline-none"
              />
            </div>
            <span class="shrink-0 rounded-full bg-[var(--color-surface-container)] border border-[var(--color-surface-dim)] px-3 py-1 font-mono text-xs text-[var(--color-secondary)]">
              <span id="visible-count">{devices.length}</span> / {devices.length}
            </span>
          </div>
        </div>

        <ol id="devices-list" class="space-y-3">
          {devices.map((device, i) => {
            const pct = grandTotal > 0 ? ((device.total / grandTotal) * 100).toFixed(1) : "0";
            const barWidth = Math.max((device.total / maxTotal) * 100, 2);
            const deviceName = getDeviceName(device.codename);

            let cardBg = "bg-[var(--color-surface-container)]";
            let cardBorder = "border-[var(--color-surface-dim)]";
            let progressGradient = "linear-gradient(90deg, var(--color-primary), var(--color-tertiary))";
            let codenameBadgeStyle = "bg-[var(--color-secondary-container)] text-[var(--color-secondary)] border border-[var(--color-secondary)]/30";

            if (i === 0) {
              cardBg = "bg-amber-500/15 dark:bg-amber-500/20";
              cardBorder = "border-amber-500/50 dark:border-amber-400/50 shadow-md shadow-amber-500/10";
              progressGradient = "linear-gradient(90deg, #f59e0b, #fbbf24)";
              codenameBadgeStyle = "bg-amber-500/20 text-amber-800 dark:text-amber-200 border border-amber-500/40";
            } else if (i === 1) {
              cardBg = "bg-slate-400/15 dark:bg-slate-400/20";
              cardBorder = "border-slate-400/50 dark:border-slate-400/50 shadow-md shadow-slate-500/10";
              progressGradient = "linear-gradient(90deg, #94a3b8, #cbd5e1)";
              codenameBadgeStyle = "bg-slate-400/25 text-slate-800 dark:text-slate-200 border border-slate-400/40";
            } else if (i === 2) {
              cardBg = "bg-orange-500/15 dark:bg-orange-500/20";
              cardBorder = "border-orange-500/50 dark:border-orange-500/50 shadow-md shadow-orange-500/10";
              progressGradient = "linear-gradient(90deg, #c2410c, #ea580c)";
              codenameBadgeStyle = "bg-orange-500/20 text-orange-800 dark:text-orange-200 border border-orange-500/40";
            }

            return (
              <li
                class={`device-item card-lift theme-transition group relative block rounded-[var(--radius-xl)] border ${cardBorder} ${cardBg} p-5 sm:p-6 transition-all`}
                data-codename={device.codename.toLowerCase()}
                data-name={deviceName.toLowerCase()}
              >
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                  <div class="flex items-center gap-3.5 min-w-0 flex-1">
                    {i === 0 || i === 1 || i === 2 ? (
                      <AwardBadge rank={(i + 1) as 1 | 2 | 3} />
                    ) : (
                      <div
                        class="flex h-10 w-10 sm:h-11 sm:w-11 shrink-0 items-center justify-center rounded-2xl border border-[var(--color-quinary)]/30 bg-[var(--color-quinary-container)] text-[var(--color-quinary)] font-[var(--font-display)] text-sm sm:text-base font-black shadow-xs select-none"
                        aria-label={`Rank ${i + 1}`}
                      >
                        {i + 1}
                      </div>
                    )}

                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 flex-wrap sm:flex-nowrap min-w-0">
                        <div class="marquee-container min-w-0 max-w-full">
                          <a
                            href={`https://get.hlcyn.org/builds/${encodeURIComponent(device.codename)}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="marquee-content font-[var(--font-display)] text-lg sm:text-xl font-bold text-[var(--color-ink)] hover:text-[var(--color-primary)] transition-colors"
                            title={`Halcyon for ${deviceName} (${device.codename})`}
                          >
                            {deviceName}
                          </a>
                        </div>
                        <span class={`rounded-full px-2.5 py-0.5 font-mono text-[11px] font-semibold shrink-0 ${codenameBadgeStyle}`}>
                          {device.codename}
                        </span>
                      </div>
                      <p class="font-mono text-xs text-[var(--color-secondary)] mt-0.5">
                        {device.builds} build{device.builds === 1 ? "" : "s"} &middot; {pct}% of downloads &middot; last pull {relativeTime(device.lastUpdated)}
                      </p>
                    </div>
                  </div>

                  <div class="flex items-center justify-between sm:justify-end gap-3 self-stretch sm:self-center">
                    <div class="flex items-baseline gap-1.5 sm:block sm:text-right">
                      <span
                        class="count-up font-mono text-lg sm:text-xl font-bold text-[var(--color-ink)]"
                        data-target={device.total}
                      >
                        {device.total.toLocaleString()}
                      </span>
                      <span class="font-mono text-[10px] text-[var(--color-secondary)]">
                        downloads
                      </span>
                    </div>

                    <a
                      href={`https://get.hlcyn.org/builds/${encodeURIComponent(device.codename)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-lift grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[var(--color-surface-dim)] text-[var(--color-ink)] hover:bg-[var(--color-primary-container)] hover:text-[var(--color-on-primary-container)] transition-colors"
                      aria-label={`Get downloads for ${device.codename}`}
                      title={`Open Halcyon downloads for ${deviceName} (${device.codename})`}
                    >
                      ↗
                    </a>
                  </div>
                </div>

                <div class="mt-4 h-2 w-full overflow-hidden rounded-full bg-[var(--color-surface-dim)]">
                  <div
                    class="progress-bar-fill h-full rounded-full"
                    data-width={`${barWidth}%`}
                    style={`width: 0%; background: ${progressGradient};`}
                  />
                </div>
              </li>
            );
          })}
        </ol>

        <p id="no-results" class="hidden my-8 rounded-[var(--radius-xl)] border border-[var(--color-surface-dim)] bg-[var(--color-surface-container)] p-8 text-center text-sm text-[var(--color-secondary)]">
          No devices matched your search.
        </p>

        <!-- Citation Info -->
        <div
          class="mt-12 flex flex-wrap items-center justify-between gap-3 rounded-[var(--radius-lg)] border border-[var(--color-surface-dim)] bg-[var(--color-surface-container)]/50 px-5 py-3 text-xs font-mono text-[var(--color-secondary)]"
        >
          <span>© 2026 neroices</span>
          <span>last update {savedAt ? savedAt.slice(0, 10) : new Date().toISOString().slice(0, 10)}</span>
        </div>
      </section>
    )
  }
</Layout>

<script>
  let updateMarquees: (() => void) | null = null;

  function setupMarquee() {
    const containers = document.querySelectorAll<HTMLElement>(".marquee-container");
    if (!containers.length) return;

    function checkMarquees() {
      containers.forEach((el) => {
        if (el.offsetParent === null) return;
        const content = el.querySelector<HTMLElement>(".marquee-content");
        if (!content) return;

        const prevAnim = content.style.animation;
        content.style.animation = "none";
        const overflow = content.scrollWidth - el.clientWidth;
        content.style.animation = prevAnim;

        if (overflow > 4) {
          el.classList.add("is-marquee");
          el.style.setProperty("--marquee-overflow", `${Math.ceil(overflow)}px`);
          const duration = Math.max(5, Math.round(overflow / 22) + 3);
          el.style.setProperty("--marquee-duration", `${duration}s`);
        } else {
          el.classList.remove("is-marquee");
          el.style.removeProperty("--marquee-overflow");
          el.style.removeProperty("--marquee-duration");
        }
      });
    }

    updateMarquees = checkMarquees;
    checkMarquees();

    if (document.fonts) {
      document.fonts.ready.then(checkMarquees);
    }

    if (typeof ResizeObserver !== "undefined") {
      const ro = new ResizeObserver(() => {
        checkMarquees();
      });
      containers.forEach((el) => ro.observe(el));
    } else {
      window.addEventListener("resize", checkMarquees);
    }
  }

  function animateCountUp(el: HTMLElement, target: number, duration = 1200) {
    const startTime = performance.now();
    el.textContent = "0";

    function step(currentTime: number) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      // Smooth ease-out cubic
      const ease = 1 - Math.pow(1 - progress, 3);
      const val = Math.round(target * ease);
      el.textContent = val.toLocaleString();

      if (progress < 1) {
        requestAnimationFrame(step);
      } else {
        el.textContent = target.toLocaleString();
      }
    }

    requestAnimationFrame(step);
  }

  function setupAnimations() {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // 1. Progress bars
    const progressBars = document.querySelectorAll<HTMLElement>(".progress-bar-fill");
    if (progressBars.length) {
      if (prefersReducedMotion || typeof IntersectionObserver === "undefined") {
        progressBars.forEach((bar) => {
          bar.style.width = bar.getAttribute("data-width") || "0%";
        });
      } else {
        const barObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const bar = entry.target as HTMLElement;
                const targetWidth = bar.getAttribute("data-width") || "0%";
                requestAnimationFrame(() => {
                  bar.style.width = targetWidth;
                });
                barObserver.unobserve(bar);
              }
            });
          },
          { threshold: 0.05, rootMargin: "60px" }
        );
        progressBars.forEach((bar) => {
          bar.style.width = "0%";
          barObserver.observe(bar);
        });
      }
    }

    // 2. Count-up effect on numbers
    const countElements = document.querySelectorAll<HTMLElement>(".count-up");
    if (countElements.length) {
      if (prefersReducedMotion || typeof IntersectionObserver === "undefined") {
        countElements.forEach((el) => {
          const target = parseInt(el.getAttribute("data-target") || "0", 10);
          if (!isNaN(target)) el.textContent = target.toLocaleString();
        });
      } else {
        const countObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                const target = parseInt(el.getAttribute("data-target") || "0", 10);
                if (!isNaN(target)) {
                  animateCountUp(el, target, 1100);
                }
                countObserver.unobserve(el);
              }
            });
          },
          { threshold: 0.05, rootMargin: "60px" }
        );
        countElements.forEach((el) => {
          countObserver.observe(el);
        });
      }
    }
  }

  function setupSearch() {
    const searchInput = document.getElementById("device-search") as HTMLInputElement | null;
    const items = document.querySelectorAll<HTMLLIElement>(".device-item");
    const visibleCount = document.getElementById("visible-count");
    const noResults = document.getElementById("no-results");

    if (!searchInput || !items.length) return;

    searchInput.addEventListener("input", () => {
      const query = searchInput.value.toLowerCase().trim();
      let shown = 0;

      items.forEach((item) => {
        const codename = item.getAttribute("data-codename") || "";
        const name = item.getAttribute("data-name") || "";
        const matches = !query || codename.includes(query) || name.includes(query);
        item.style.display = matches ? "" : "none";
        if (matches) shown++;
      });

      if (visibleCount) visibleCount.textContent = String(shown);
      if (noResults) noResults.classList.toggle("hidden", shown > 0);
      if (updateMarquees) {
        requestAnimationFrame(updateMarquees);
      }
    });
  }

  function init() {
    setupSearch();
    setupMarquee();
    setupAnimations();
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
